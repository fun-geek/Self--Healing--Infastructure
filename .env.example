# =============================================================================
# SENTINEL AI - example configuration. Copy to .env and edit.
# NEVER commit .env. Values below are safe development placeholders only.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# Only "simulator" is accepted. The application refuses to start otherwise.
SENTINEL_MODE=simulator
SENTINEL_ENVIRONMENT=dev
SENTINEL_LOG_LEVEL=INFO
SENTINEL_DATA_DIR=data
SENTINEL_VAR_DIR=var

# --- Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (>=32 chars) when SENTINEL_ENVIRONMENT=prod.
# In dev/test, if unset, a secret is generated once into var/.jwt_secret.
# SENTINEL_JWT_SECRET=
SENTINEL_SESSION_TTL_MINUTES=30
SENTINEL_LOGIN_RATE_LIMIT_PER_MINUTE=5
SENTINEL_LOGIN_LOCKOUT_MINUTES=5
SENTINEL_API_RATE_LIMIT_PER_MINUTE=240
SENTINEL_MAX_REQUEST_BYTES=262144
SENTINEL_CORS_ORIGINS=
# The demo bootstrap password is generated by `python -m sentinel bootstrap-admin`
# and printed once. Never put a real password in a committed file.
# SENTINEL_DEV_ADMIN_PASSWORD=

# --- Simulator / remediation -------------------------------------------------
SENTINEL_AUTO_REMEDIATE=true
SENTINEL_MAX_RESTORE_ATTEMPTS=2
SENTINEL_WORKER_THREADS=2
SENTINEL_STRICT_BASELINE_INTEGRITY=true
SENTINEL_SIMULATOR_FAULTS=data/sim/faults.json

# --- AI (optional; platform is fully functional with none) -------------------
# none | ollama | openai_compat
SENTINEL_LLM_PROVIDER=none
# SENTINEL_LLM_BASE_URL=http://127.0.0.1:11434
# SENTINEL_LLM_MODEL=llama3.1:8b
# SENTINEL_LLM_API_KEY=
SENTINEL_LLM_TIMEOUT_SECONDS=20

# --- Retrieval (RAG) ---------------------------------------------------------
# bm25 is deterministic, offline and dependency-free. "chroma" requires extras.
SENTINEL_RAG_BACKEND=bm25
SENTINEL_RAG_TOP_K=4
SENTINEL_ALLOW_MODEL_DOWNLOAD=false
